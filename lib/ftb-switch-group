#!/hint/zsh
emulate -L zsh -o extended_glob

zmodload zsh/mapfile

# receive arguments
# offset is -1/1 to switch group, or "sort" to toggle sorting by most recently modified
local pid=$1 header_lines=$2 active_group_style=$3 tmp_dir=$4 offset=$5

# read completion list
local -a list=(${(f)mapfile[$tmp_dir/completions.$pid]})

# toggle recent sort, keeping the current group
local sort_file=$tmp_dir/sort-recent.$pid
if [[ $offset == sort ]]; then
  if [[ -f $sort_file ]]; then
    command rm $sort_file
  else
    : > $sort_file
  fi
  offset=0
fi

# --- group marker detection (fzf-tab groups) ---------------------------------
# When groups exist, fzf-tab prefixes each entry with a group SGR like $'\e[94m'.
# When no groups exist (often file lists), entries may start with $'\e[0m'
# (reset for LS_COLORS). Treat that as "no groups".
local -Ua group_sgr_prefixes
if (( $#list > 10000 && $+commands[grep] )); then
  group_sgr_prefixes=(${(f)"$(print -l -- ${list:$header_lines} | command grep -a -o $'^\x1b\\[[0-9;]*m')"})
else
  group_sgr_prefixes=(${(M)${list:$header_lines}#$'\x1b['[0-9;]#*m})
fi

# if the only marker is reset, there are no real groups
if (( $#group_sgr_prefixes == 1 )) && [[ $group_sgr_prefixes[1] == $'\e[0m' ]]; then
  group_sgr_prefixes=()
fi

local -a headers=(${list[1,header_lines]}) entries

# toggling sort before any group switch keeps showing all groups
if (( offset == 0 )) && [[ ! -f $tmp_dir/current-group.$pid ]]; then
  entries=(${list:$header_lines})
else
  # calculate and persist current group index
  # the index starts from 2, because switching from "all" to "group 1" looks weird
  local current=2
  if (( $#group_sgr_prefixes > 0 )) && [[ -f $tmp_dir/current-group.$pid ]]; then
    current=$(( $(<$tmp_dir/current-group.$pid) + offset ))
  fi
  (( current > $#group_sgr_prefixes )) && current=1
  (( current == 0 )) && current=$#group_sgr_prefixes
  echo $current > $tmp_dir/current-group.$pid

  # configure style of active header
  local sgr_on='' sgr_off=''
  case $active_group_style in
    (bold)          sgr_on=$'\x1b[1m';    sgr_off=$'\x1b[22m' ;;
    (underline)     sgr_on=$'\x1b[4m';    sgr_off=$'\x1b[24m' ;;
    (bold,underline) sgr_on=$'\x1b[1;4m'; sgr_off=$'\x1b[22;24m' ;;
    (none)          sgr_on='';            sgr_off='' ;;
    (*)             sgr_on=$'\x1b[1m';    sgr_off=$'\x1b[22m' ;;  # fallback
  esac

  # The ANSI SGR code that marks every line in the currently selected group.
  local current_prefix=$group_sgr_prefixes[current]

  # Apply style only to the group label (excluding trailing spaces), then disable it
  headers=(${${(S)headers/(#b)($current_prefix*)($'\x1b[00m')/${match[1]/%(#b)( #)/$sgr_off$match}$match[2]}/$current_prefix/$current_prefix$sgr_on})

  if (( $#list > 10000 && $+commands[grep] )); then
    entries=(${(f)"$(print -l -- ${list:$header_lines} | command grep -a -F -- "$current_prefix")"})
  else
    entries=(${(M)${list:$header_lines}:#$current_prefix*})
  fi
fi

# sort files by modification time, newest first, and show a relative time in a 4th field
# entries that aren't files keep their order at the end
if [[ -f $sort_file ]]; then
  zmodload zsh/datetime
  zmodload -F zsh/stat b:zstat

  # map each candidate to its path, see -ftb-preview.tpl
  local -A paths
  local cap
  for cap in ${(f)mapfile[$tmp_dir/compcap.$pid]}; do
    local -A v=("${(@0)${cap#*$'\2'}}")
    (( $+v[realdir] )) && paths[${cap%%$'\2'*}]=$v[realdir]${(Q)v[word]}
  done

  local line name visible age rel unit
  local -i i n width=0
  local -a st mtimes widths keyed
  for line in $entries; do
    name=${${line#*$'\0'}%%$'\0'*}
    if (( $+paths[$name] )); then
      zstat -L -A st +mtime -- $paths[$name]
      mtimes+=$st[1]
    else
      mtimes+=0
    fi
    visible=$name${${line##*$'\0'}//$'\e['[0-9;]#m}
    widths+=${(m)#visible}
    (( widths[-1] > width )) && width=$widths[-1]
  done

  for i in {1..$#entries}; do
    rel=''
    if (( mtimes[i] )); then
      age=$(( EPOCHSECONDS > mtimes[i] ? EPOCHSECONDS - mtimes[i] : 0 ))
      if   (( age < 60 ));       then n=age unit=second
      elif (( age < 3600 ));     then n=age/60 unit=minute
      elif (( age < 86400 ));    then n=age/3600 unit=hour
      elif (( age < 604800 ));   then n=age/86400 unit=day
      elif (( age < 2592000 ));  then n=age/604800 unit=week
      elif (( age < 31536000 )); then n=age/2592000 unit=month
      else                            n=age/31536000 unit=year
      fi
      rel="$n $unit"
      (( n == 1 )) || rel+=s
    fi
    # 12-digit mtime + 8-digit reversed index, so a descending sort keeps ties in order
    keyed+=${(l:12::0:)mtimes[i]}${(l:8::0:)$(( 99999999 - i ))}$entries[i]$'\0'${(l:width-widths[i]+2:)${:-}}$'\e[2m'$rel$'\e[22m'
  done
  entries=(${(@)${(@O)keyed}/#[0-9](#c20)})
fi

print -rl -- $headers $entries
